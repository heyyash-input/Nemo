# Existing local MongoDB or Atlas. Credentials belong in .env only.
MONGODB_URI=mongodb://127.0.0.1:27017/nemo_expenses
PORT=4000
APP_ORIGIN=http://127.0.0.1:5173
NODE_ENV=development
HOST=127.0.0.1
DEMO_MODE=false
# Signup requires SMTP. Port 587 uses STARTTLS; 465 uses SMTP_SECURE=true.
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=
# Random secret of at least 32 characters. Used to protect stored OTPs.
OTP_SECRET=
# Optional comma-separated company domains; blank allows any verified email.
SIGNUP_ALLOWED_DOMAINS=
# Trusted reverse-proxy IPs/subnets, comma-separated. Blank for direct access.
TRUST_PROXY=
# Optional: override the password generated and saved in .data/demo-credentials.txt.
# Required when explicitly seeding a remote database with SEED_DEMO=true.
DEMO_PASSWORD=
SEED_DEMO=false
# First administrator only; remove ADMIN_PASSWORD after running the admin task.
ADMIN_EMAIL=
ADMIN_PASSWORD=
