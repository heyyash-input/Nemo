# Copy to .env.docker. Real values stay outside the image and Git.
# Docker Desktop + existing Windows MongoDB (local evaluation only):
# MONGODB_URI=mongodb://host.docker.internal:27017/nemo_expenses
# For deployment use an authenticated MongoDB server or Atlas URI.
MONGODB_URI=
APP_ORIGIN=https://nemo.example.com
OTP_SECRET=
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=
SIGNUP_ALLOWED_DOMAINS=
# Set only to the known IPs/subnets of the trusted reverse proxy.
TRUST_PROXY=
